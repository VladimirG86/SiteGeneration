# Nelvi — Caddy on-demand TLS для поддоменов *.nelvi.app
# {$DOMAIN} — основной домен из .env (например nelvi.app). Для локалки — localhost.
{
	# on-demand TLS для поддоменов (SaaS)
	on_demand_tls {
		ask http://app:8000/api/caddy/ask
	}
	email {$ACME_EMAIL:}
}

{$DOMAIN:localhost} {
	encode gzip
	reverse_proxy app:8000
}

# wildcard для сайтов клиентов — *.nelvi.app → тот же app, app сам резолвит Host
*.{$DOMAIN} {
	encode gzip
	tls {
		on_demand
	}
	reverse_proxy app:8000
}

# health
:80 {
	respond "Nelvi Caddy OK" 200
}
