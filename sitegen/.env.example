# RouterAI (https://routerai.ru) — оплата в рублях, OpenAI-совместимый API
# Скопируй в .env и вставь свой ключ из https://routerai.ru/settings/keys
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
# Генерация сайта и чат-редактор
SITEGEN_MODEL=deepseek/deepseek-v4-pro-0813
# Подсказки-чипы (можно дешевле/быстрее)
SITEGEN_MODEL_FAST=deepseek/deepseek-v4-pro-0813
# Изображения: hero и фото товаров
SITEGEN_IMAGE_MODEL=bytedance-seed/seedream-4.5
SITEGEN_IMAGE_MODEL_FAST=krea/krea-2-medium-turbo
# Токен для чтения заявок: GET /api/leads/{id}?token=... (пусто = открыто всем, только для локалки)
SITEGEN_ADMIN_TOKEN=
